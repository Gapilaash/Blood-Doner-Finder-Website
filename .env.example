# Copy to ".env" for local use. On Vercel, add the same names under Project > Settings > Environment Variables.

# PostgreSQL connection string (Neon / Supabase / Vercel Postgres).
# Leave EMPTY locally to use the built-in embedded database (stored in ./data).
DATABASE_URL=

# REQUIRED on Vercel: any long random text
JWT_SECRET=
# REQUIRED on Vercel: protects the daily cron endpoint (Vercel sends it automatically)
CRON_SECRET=

# First admin account (created automatically on first start)
ADMIN_EMAIL=admin@blooddonor.com
ADMIN_PASSWORD=Admin@123
ADMIN_PHONE=+94700000000

# The one hospital this installation serves
HOSPITAL_NAME=Batticaloa Hospital
HOSPITAL_CITY=Batticaloa
# Optional: blood bank phone number shown to donors
HOSPITAL_PHONE=

ELIGIBILITY_DAYS=90
# true = forgot-password code is returned on screen (demo, no email server). Use false in production.
DEV_RESET_CODE_IN_RESPONSE=true

# Optional
GOOGLE_CLIENT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# FREE e-mail alerts to donors. Use ONE of the two options below.
#
# Option A - Gmail (works with a Google account that has 2-Step Verification ON)
#   Google Account > Security > 2-Step Verification (turn on) > App passwords > create one
#   Paste the 16-letter app password below (NOT your normal Gmail password).
GMAIL_USER=
GMAIL_APP_PASSWORD=
#
# Option B - Brevo (free plan, 300 e-mails/day): brevo.com > Senders (verify MAIL_FROM_EMAIL) > SMTP & API > API keys
BREVO_API_KEY=
MAIL_FROM_EMAIL=
#
MAIL_FROM_NAME=Blood Donor Finder
# Public address of your site; the e-mail gets an "Open Blood Donor Finder" link to it
APP_URL=

# ---- Alerts and reminders ----
# Emergency requests alert all matching donors the moment they are created: emergency (default) | all | off
AUTO_ALERT=emergency
# Donors who have not answered are reminded again (Emergency every 5 min, Urgent 10 min, Normal 15 min). Max alerts per donor:
REMINDER_MAX=10
# Daily backup files kept in data/backups (not used on Vercel)
BACKUP_KEEP=14
